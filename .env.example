# 全部可配置项参考。平时不用管，默认值已经够用。
#
# 两种使用方式（二选一）：
#
#   1) 只改几项（推荐）——直接写在 docker-compose.yml 的 environment 里：
#        environment:
#          - TZ=America/Toronto
#          - ERP_COOKIE_SECURE=1
#
#   2) 想集中管理——把本文件复制成 .env，改完后在 docker-compose.yml 里加一行：
#        env_file: [.env]
#
# 注意：网页「系统设置」里能改的项目（公司名、币种、币种符号、库存预警线、
# 是否允许负库存）优先级更高，改完立即生效，不需要重启，也不用动这里。

# ---------------------------------------------------------------- 常用
TZ=Asia/Shanghai

# 应用名称（浏览器标题、登录页、侧边栏显示）
# ERP_APP_NAME=加拿大冰酒 ERP

# 初始管理员账号。只在数据库里还没有任何用户时生效。
# 登录后请立刻在「我的账号」里改密码。
# ERP_ADMIN_USERNAME=admin
# ERP_ADMIN_PASSWORD=admin123
# ERP_ADMIN_NAME=老板

# 外层反向代理挂好 HTTPS 之后设为 1（Cookie 只走加密连接）
# ERP_COOKIE_SECURE=0

# 首次启动写入演示数据（4 款冰酒 + 1 张采购单 + 4 场市集）
# ERP_SEED_DEMO=0

# ---------------------------------------------------------------- 其他
# 下面这些在 Docker 里通常不需要改，列出供参考。

# 币种代码与符号（只影响显示与报表口径）
# ERP_CURRENCY=CAD
# ERP_CURRENCY_SYMBOL=C$

# 新建产品时的默认库存预警线（瓶）
# ERP_LOW_STOCK=6

# 登录状态保持多少小时
# ERP_SESSION_HOURS=72

# 会话签名密钥。留空会自动生成到 <数据目录>/secret.key，一般不用填。
# 需要手工指定时：openssl rand -hex 32
# ERP_SECRET_KEY=

# 监听地址（容器内固定 8123，改了要同时改 compose 的端口映射）
# ERP_ADDR=:8123

# 数据目录与数据库文件位置（容器内固定 /data，对应宿主机的 ./data）
# ERP_DATA_DIR=/data
# ERP_DB_PATH=/data/erp.sqlite3
# ERP_BACKUP_DIR=/data/backups

# 版本号（只用于启动日志与「系统设置」页显示）
# ERP_VERSION=1.0.0
