# 复制成 .env 后按需修改：cp .env.example .env
# 所有项都有默认值，不配置也能启动。

# ---------------------------------------------------------------- 基本信息
TZ=Asia/Shanghai
ERP_APP_NAME=加拿大冰酒 ERP
ERP_VERSION=1.0.0

# ---------------------------------------------------------------- 镜像来源
# 默认在服务器上本地构建（不需要登录任何镜像仓库，最省事）。
# 想直接用 GitHub Actions 构建好的双架构镜像，取消下面两行注释：
# ERP_IMAGE=ghcr.io/ladavian/soulfound-erp:latest
# ERP_PULL_POLICY=always

# ---------------------------------------------------------------- 访问
# 监听端口（宿主机）。改了之后访问 http://服务器IP:端口
ERP_PORT=8000
# 只允许本机访问改成 127.0.0.1；允许局域网访问保留 0.0.0.0
ERP_BIND=0.0.0.0

# ---------------------------------------------------------------- 初始管理员
# 只在数据库里还没有任何用户时生效，登录后请立刻改密码
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=admin123
# ERP_ADMIN_NAME=老板

# ---------------------------------------------------------------- 业务默认值
# 币种（只影响显示与报表口径）
ERP_CURRENCY=CAD
ERP_CURRENCY_SYMBOL=C$
# 新建产品时的默认库存预警线（瓶）
ERP_LOW_STOCK=6
# 登录状态保持多少小时
ERP_SESSION_HOURS=72
# 首次启动是否写入演示数据（正式使用请保持 0）
ERP_SEED_DEMO=0

# ---------------------------------------------------------------- 安全
# 会话签名密钥。留空则自动生成到 data/secret.key，一般不用填。
# 需要手工指定时用：openssl rand -hex 32
# ERP_SECRET_KEY=
# 走 HTTPS 后设为 1
ERP_COOKIE_SECURE=0

# ---------------------------------------------------------------- HTTPS（可选）
# 想用 PWA「添加到主屏幕」需要 HTTPS。有两种方式：
#
# A. 有域名（推荐，自动申请免费证书）
#    把域名解析到这台服务器，然后：
#    ERP_DOMAIN=erp.example.com
#    ERP_CADDYFILE=Caddyfile.domain
#    ERP_COOKIE_SECURE=1
#
# B. 只有局域网 IP（自签证书，手机需要信任一次根证书，见 README）
#    ERP_DOMAIN=192.168.1.10
#    ERP_CADDYFILE=Caddyfile.internal
#    ERP_COOKIE_SECURE=1
#
# ERP_DOMAIN=erp.example.com
# ERP_CADDYFILE=Caddyfile.domain
# ERP_HTTPS_PORT=443
# ERP_HTTP_PORT=80
